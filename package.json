{
  "name": "englishbot-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace TypeScript cho EnglishBot",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "quality": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "test": "vitest run",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "verify:all": "node scripts/verify-repository.mjs",
    "verify:docs": "pnpm run docs:check && pnpm run secrets:scan",
    "verify:frontend": "pnpm install --frozen-lockfile && pnpm run quality"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
